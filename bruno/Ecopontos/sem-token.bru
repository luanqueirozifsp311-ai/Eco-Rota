meta {
  name: Criar sem token (401)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/ecopontos
  body: json
  auth: none
}

body:json {
  {
    "nome": "Ecoponto Centro",
    "endereco": "Av. Brasil, 100 - Centro, Caraguatatuba",
    "horario": "Seg à Sáb, das 08:30 às 17:00",
    "descartes": "Podas, Entulhos, Vidros",
    "latitude": -23.6203,
    "longitude": -45.4131
  }
}

assert {
  res.status: eq 401
  res.body.erro.codigo: eq NAO_AUTENTICADO
}
