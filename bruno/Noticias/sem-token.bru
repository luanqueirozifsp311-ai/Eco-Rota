meta {
  name: Criar sem token (401)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/noticias
  body: json
  auth: none
}

body:json {
  {
    "categoria": "Utilidade",
    "titulo": "Coleta seletiva chega a novos bairros",
    "texto": "A coleta seletiva foi ampliada para mais bairros da cidade.",
    "foto": "/img/card1.png",
    "link": "https://www.caraguatatuba.sp.gov.br"
  }
}

assert {
  res.status: eq 401
  res.body.erro.codigo: eq NAO_AUTENTICADO
}
