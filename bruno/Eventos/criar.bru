meta {
  name: Criar evento
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/eventos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "titulo": "Plantio de Mudas",
    "data": "2026-12-05",
    "local": "Parque Tinga",
    "descricao": "Plantio de mudas nativas com a comunidade."
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("eventoId", res.body.id);
  }
}
