meta {
  name: Criar sem token (401)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/eventos
  body: json
  auth: none
}

body:json {
  {
    "titulo": "Plantio de Mudas",
    "data": "2026-12-05",
    "local": "Parque Tinga",
    "descricao": "Plantio de mudas nativas com a comunidade."
  }
}

assert {
  res.status: eq 401
  res.body.erro.codigo: eq NAO_AUTENTICADO
}
