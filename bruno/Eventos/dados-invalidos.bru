meta {
  name: Criar com dados inválidos (400)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/eventos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "titulo": "",
    "data": "08/11/2026"
  }
}

assert {
  res.status: eq 400
  res.body.erro.codigo: eq VALIDACAO
}
