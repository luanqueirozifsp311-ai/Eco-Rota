# Banco de dados MySQL externo (obrigatório em produção)
# Opção 1 (recomendada em bancos gerenciados): URL completa
DATABASE_URL=mysql://usuario:senha@host:3306/ecorota
# DATABASE_SSL=true

# Opção 2: variáveis separadas (use em vez de DATABASE_URL)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=
DATABASE_NAME=ecorota

# API
PORT=3333
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio
# Origens permitidas (separadas por vírgula). Use * para qualquer uma.
# Na Vercel com /api no mesmo domínio, não é obrigatório preencher.
CORS_ORIGIN=http://localhost:5173

# Seed (apenas na primeira configuração do banco)
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Notícias da Prefeitura (recurso opcional, hoje desativado no site)
NOTICIAS_BASE_URL=https://www.caraguatatuba.sp.gov.br/pmc
NOTICIAS_CACHE_MIN=10
